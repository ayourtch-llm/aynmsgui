<h1 class="list-page-heading">Config Diff Overview</h1>
{{> quicksearch}}
<div class="table-scroll">
<table id="{{quicksearch_table_id}}">
<thead><tr><th>Serial</th><th>Logical Device</th><th>Status</th><th>Preview</th><th>Action</th></tr></thead>
<tbody>
{{#items}}
<tr class="{{status_class}}">
  <td><a href="/diff/{{name}}">{{name}}</a></td>
  <td>{{device_name}}</td>
  <td>{{status_text}}</td>
  <td><pre>{{diff_preview}}</pre></td>
  <td>
    {{#has_diff}}<a href="/apply/{{name}}">Apply</a>{{/has_diff}}
    <form method="POST" action="/retrieve" style="display:inline; margin-left:8px;">
      <input type="hidden" name="select_{{name}}" value="on">
      <button type="submit"{{#retrieve_disabled}} title="{{retrieve_reason}}" disabled{{/retrieve_disabled}}>Retrieve</button>
    </form>
  </td>
</tr>
{{/items}}
</tbody>
</table>
</div>
{{> colresize}}
