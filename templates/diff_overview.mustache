<h1 class="list-page-heading">Config Diff Overview</h1>
<p style="margin: 0 0 8px 0;">
  <a href="/reconcile/services">Service prologue reconciliation →</a>
  &nbsp;·&nbsp;
  <form method="POST" action="/diff/recompile-all" style="display:inline;"
        onsubmit="return confirm('Recompile every logical-device target config? Local only — does not touch live devices.');">
    <button type="submit">Recompile all targets</button>
  </form>
</p>
{{> quicksearch}}
<div class="table-scroll">
<table id="{{quicksearch_table_id}}">
<thead><tr><th>Serial</th><th>Logical Device</th><th>Hostname</th><th>Status</th><th>Preview</th><th>Action</th></tr></thead>
<tbody>
{{#items}}
<tr class="{{status_class}}">
  <td><a href="/diff/{{name}}">{{name}}</a></td>
  <td>
    {{device_name}}
    {{#is_stack}}
    <span class="stack-badge" title="Stack of {{chassis_count}} chassis: {{chassis_serials}}">stack: {{chassis_count}}</span>
    {{/is_stack}}
  </td>
  <td>{{hostname}}</td>
  <td>{{status_text}}</td>
  <td>
    {{#has_diff}}
      <pre class="diff-preview">{{#diff_lines}}<span class="{{#is_remove}}diff-remove{{/is_remove}}{{^is_remove}}diff-add{{/is_remove}}">{{text}}</span>
{{/diff_lines}}{{#has_more}}<span class="diff-more">… +{{diff_more}} more line(s)</span>{{/has_more}}</pre>
      <div class="diff-stats">+{{diff_added}} / −{{diff_removed}} · {{diff_total}} line(s) total</div>
    {{/has_diff}}
    {{^has_diff}}<span style="color:#888;">No changes</span>{{/has_diff}}
  </td>
  <td>
    {{#has_diff}}<a href="/apply/{{name}}">Apply</a> ·
    <a href="/diff/{{name}}/reconcile">Reconcile</a>{{/has_diff}}
    <form method="POST" action="/retrieve" style="display:inline; margin-left:8px;">
      <input type="hidden" name="select_{{name}}" value="on">
      <button type="submit"{{#retrieve_disabled}} title="{{retrieve_reason}}" disabled{{/retrieve_disabled}}>Retrieve</button>
    </form>
    <form method="POST" action="/diff/{{name}}/recompile" style="display:inline; margin-left:4px;">
      <button type="submit" title="Re-run compile_device_config for this device, refreshing its target .cfg from current cfggen state">Recompile</button>
    </form>
  </td>
</tr>
{{/items}}
</tbody>
</table>
</div>
{{> colresize}}
