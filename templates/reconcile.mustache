<h1 class="list-page-heading">Reconcile: {{name}}</h1>
<p>
  <strong>Logical device:</strong> {{device_name}} ·
  <strong>Hostname:</strong> {{hostname}}
  &nbsp;|&nbsp;
  <a href="/diff/{{name}}">Full diff view</a> ·
  <a href="/devices/{{device_name}}">Edit logical device</a>
</p>

{{#is_preview}}
<div class="reconcile-preview-banner">
  <strong>Preview mode:</strong> {{preview_banner}}.
  Numbers below are the projected delta if you apply this swap.
  <form method="POST" action="/diff/{{name}}/reconcile/swap" style="display:inline; margin-left:12px;">
    <input type="hidden" name="module_idx" value="{{preview_module_idx}}">
    <input type="hidden" name="port_name" value="{{preview_port_name}}">
    <input type="hidden" name="service" value="{{preview_service}}">
    <button type="submit">Commit swap</button>
  </form>
  <a href="/diff/{{name}}/reconcile" style="margin-left:8px;">Cancel preview</a>
</div>
{{/is_preview}}

{{^has_delta}}
<p style="color:#1b5e20; font-weight:600;">No changes — target and current configs match. Nothing to reconcile.</p>
{{/has_delta}}

{{#has_delta}}
<div class="reconcile-summary">
  <strong>{{total_count}}</strong> delta line(s) ·
  <span style="color:#1b5e20;">{{resolved_count}} resolved</span> ·
  <span style="color:#888;">{{unresolved_count}} unresolved</span> ·
  <strong>{{affected_services}}</strong> service(s) touched
</div>

{{#has_port_groups}}
<h2>Per-port changes</h2>
<p style="color:#666; font-size:0.9em;">
  Pick a different service from the dropdown to see what the diff would look like with that
  service in place. Nothing is written to disk until you click <em>Commit swap</em>.
</p>
{{#port_groups}}
<details class="port-group{{#is_previewing}} previewing{{/is_previewing}}{{#is_template_port}} template-port{{/is_template_port}}" open>
  <summary>
    <strong>{{derived_interface}}</strong>
    {{#is_json_port}}
      &nbsp;·&nbsp; <code>{{port_name}}</code>
      &nbsp;·&nbsp; current service: <code>{{current_service}}</code>
    {{/is_json_port}}
    {{#is_template_port}}
      &nbsp;·&nbsp; <span style="color:#b07000; font-weight:600;">template-baked</span>
      &nbsp;·&nbsp; <code>{{template_path}}:{{template_line}}</code>
    {{/is_template_port}}
    &nbsp;·&nbsp; {{line_count}} delta line(s)
    {{#is_previewing}}
    &nbsp;·&nbsp; <span style="color:#1a5276; font-weight:600;">previewing → {{previewing_service}}</span>
    {{/is_previewing}}
  </summary>
  {{#is_json_port}}
  <form method="GET" action="/diff/{{name}}/reconcile" class="port-group-form">
    <input type="hidden" name="try_module" value="{{module_idx}}">
    <input type="hidden" name="try_port" value="{{port_name}}">
    <label>Try alternate service:
      <select name="try_service">
        {{#service_options}}
        <option value="{{name}}"{{#selected}} selected{{/selected}}>{{name}}</option>
        {{/service_options}}
      </select>
    </label>
    <button type="submit">Preview swap</button>
  </form>
  {{#has_suggestion}}
  <form method="GET" action="/diff/{{name}}/reconcile" class="port-group-suggestion-form">
    <input type="hidden" name="try_module" value="{{module_idx}}">
    <input type="hidden" name="try_port" value="{{port_name}}">
    <input type="hidden" name="try_service" value="{{suggested_service}}">
    <span class="port-group-suggestion">
      <strong>Import matcher suggests:</strong> <code>{{suggested_service}}</code>
      <button type="submit">Preview suggestion</button>
    </span>
  </form>
  {{/has_suggestion}}
  {{#has_prologue}}
  <form method="GET" action="/diff/{{name}}/reconcile/fold-prologue" class="port-group-fold-form">
    <input type="hidden" name="service" value="{{current_service}}">
    <input type="hidden" name="prologue" value="{{prologue_text}}">
    <span class="port-group-fold">
      <strong>Per-port prologue:</strong> <code>{{prologue_text}}</code>
      <button type="submit" title="Move this line into the service's port-config.txt so every port using this (service, prologue) pair on any device drops its per-port prologue">Fold into {{current_service}} …</button>
    </span>
  </form>
  {{/has_prologue}}
  {{/is_json_port}}
  {{#is_template_port}}
  <p style="color:#666; font-size:0.9em; margin: 4px 0 8px 0;">
    This interface block is baked into the device template at
    <code>{{template_path}}:{{template_line}}</code> — there's no port assignment
    in the device JSON for it. To change these lines either edit the template
    directly, or promote this interface to a managed port by adding it under
    <code>modules[].ports[]</code>.
  </p>
  {{/is_template_port}}
  <table class="reconcile-table">
    <thead><tr><th style="width:60%;">Delta line</th><th>Source</th></tr></thead>
    <tbody>
    {{#lines}}
    <tr class="rec-{{direction}}">
      <td><pre class="rec-line">{{text}}</pre></td>
      <td><span class="rec-src-badge {{source_class}}">{{source_label}}</span></td>
    </tr>
    {{/lines}}
    </tbody>
  </table>
</details>
{{/port_groups}}
{{/has_port_groups}}

{{#has_svi_groups}}
<h2>SVI service changes</h2>
{{#svi_groups}}
<details class="svi-group" open>
  <summary>
    <strong>{{service}}</strong> &nbsp;·&nbsp; {{line_count}} delta line(s)
  </summary>
  <table class="reconcile-table">
    <thead><tr><th style="width:60%;">Delta line</th><th>Source</th></tr></thead>
    <tbody>
    {{#lines}}
    <tr class="rec-{{direction}}">
      <td><pre class="rec-line">{{text}}</pre></td>
      <td><span class="rec-src-badge {{source_class}}">{{source_label}}</span></td>
    </tr>
    {{/lines}}
    </tbody>
  </table>
</details>
{{/svi_groups}}
{{/has_svi_groups}}

{{#has_drift_lines}}
<h2>Drift — currently on device but not in target</h2>
<p style="color:#666; font-size:0.9em;">
  These are commands that the device actually has running but the target config doesn't
  include — so the next apply would negate them. (The transition generator emits each one
  prefixed with <code>no</code>; we show the underlying command here so absorbing into a
  service is byte-for-byte the same as what gets written.) Click
  <em>Absorb into service</em> to append the command to the inferred port's service so
  the target keeps it and the drift disappears.
</p>
<table class="reconcile-table">
<thead><tr><th>Command on device</th><th>Negation emitted by transition</th><th>Inferred port → service</th><th>Action</th></tr></thead>
<tbody>
{{#drift_lines}}
<tr class="rec-remove">
  <td><pre class="rec-line">{{bare_cmd}}</pre></td>
  <td><code style="color:#888; font-size:0.85em;">{{full_text}}</code></td>
  <td>
    {{#has_port}}
    <code>{{port_name}}</code> · <code>{{current_service}}</code>
    {{/has_port}}
    {{^has_port}}
    <em style="color:#888;">no port context (drift outside interface block)</em>
    {{/has_port}}
  </td>
  <td>
    {{#has_port}}
    {{#has_suggestion}}
    <form method="GET" action="/diff/{{name}}/reconcile" style="display:inline;">
      <input type="hidden" name="try_module" value="{{module_idx}}">
      <input type="hidden" name="try_port" value="{{port_name}}">
      <input type="hidden" name="try_service" value="{{suggested_service}}">
      <button type="submit" title="The device's body for this port matches {{suggested_service}} exactly. Previewing this swap likely resolves every drift line on this port at once.">Swap port to {{suggested_service}}</button>
    </form>
    <br>
    {{/has_suggestion}}
    <form method="POST" action="/diff/{{name}}/reconcile/absorb" style="display:inline;">
      <input type="hidden" name="module_idx" value="{{module_idx}}">
      <input type="hidden" name="port_name" value="{{port_name}}">
      <input type="hidden" name="service" value="{{current_service}}">
      <input type="hidden" name="command" value="{{bare_cmd}}">
      <button type="submit" title="Append this single command to {{current_service}}/port-config.txt — use when only this one line is missing from the assigned service, not when the whole port body suggests a different service.">Absorb into {{current_service}}</button>
    </form>
    {{/has_port}}
    {{^has_port}}
    {{#can_splice}}
    <form method="POST" action="/diff/{{name}}/reconcile/splice-template" style="display:inline;"
          onsubmit="return confirm('Insert this line into {{splice_template_path}} after line {{splice_after_line}}, then recompile? Local edit only.');">
      <input type="hidden" name="template_path" value="{{splice_template_path}}">
      <input type="hidden" name="after_line" value="{{splice_after_line}}">
      <input type="hidden" name="line" value="{{bare_cmd}}">
      <button type="submit" title="Insert this command into {{splice_template_path}} {{#splice_anchor}}right after `{{splice_anchor}}` (line {{splice_after_line}}){{/splice_anchor}}{{^splice_anchor}}at the end of file{{/splice_anchor}}">Splice into template</button>
    </form>
    {{/can_splice}}
    {{/has_port}}
  </td>
</tr>
{{/drift_lines}}
</tbody>
</table>
{{/has_drift_lines}}

{{#has_other_lines}}
<h2>Other delta lines (template, structural, unresolved)</h2>
<table class="reconcile-table">
<thead><tr><th style="width:60%;">Delta line</th><th>Source</th></tr></thead>
<tbody>
{{#other_lines}}
<tr class="rec-{{direction}}">
  <td><pre class="rec-line">{{text}}</pre></td>
  <td><span class="rec-src-badge {{source_class}}">{{source_label}}</span></td>
</tr>
{{/other_lines}}
</tbody>
</table>
{{/has_other_lines}}

{{/has_delta}}

<p style="margin-top:18px;"><a href="/diff">← Back to overview</a></p>
