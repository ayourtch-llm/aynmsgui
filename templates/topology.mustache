<div class="topology-page">
<h1 class="topology-title">Topology</h1>
<div id="topology-toolbar">
  <button id="topology-refresh" type="button">Refresh</button>
  <button id="topology-reset-layout" type="button" title="Clear saved positions and re-run auto-layout">Reset layout</button>
  <button id="topology-clear-history" type="button" title="Wipe every cached device/edge (including stale ones)">Clear history</button>
  <label><input type="checkbox" id="topology-managed-only"> Managed only</label>
  <label>Layout:
    <select id="topology-layout">
      <option value="fcose" selected>fcose (compound)</option>
      <option value="ranked">ranked (hub-and-spoke)</option>
      <option value="cose">cose</option>
      <option value="concentric">concentric</option>
      <option value="grid">grid</option>
      <option value="circle">circle</option>
      <option value="breadthfirst">breadth-first</option>
    </select>
  </label>
  <label><input type="checkbox" id="topology-autorefresh" checked> Auto-refresh (30s)</label>
  <span class="topology-search-wrap">
    <input type="text" id="topology-search" placeholder="Find name / description…" autocomplete="off">
    <button type="button" id="topology-search-clear" title="Clear search" aria-label="Clear search">×</button>
    <ul id="topology-search-results" role="listbox" hidden></ul>
  </span>
  <span id="topology-status" style="color:#666; font-size:0.9em;">loading…</span>
  <span style="margin-left:auto; color:#666; font-size:0.85em;">
    Gray = managed · arrow points TO the device source sees · ctrl+right-click cycles BFS selection.
  </span>
</div>
<div class="topology-body">
  <div id="cy"></div>
  <aside id="topology-detail"><em>Click a node for details.</em></aside>
</div>
</div>
<script src="https://unpkg.com/cytoscape@3.30.2/dist/cytoscape.min.js"></script>
<script src="https://unpkg.com/layout-base@2.0.1/layout-base.js"></script>
<script src="https://unpkg.com/cose-base@2.2.0/cose-base.js"></script>
<script src="https://unpkg.com/cytoscape-fcose@2.2.0/cytoscape-fcose.js"></script>
<script>if (window.cytoscape && window.cytoscapeFcose) cytoscape.use(cytoscapeFcose);</script>
<script src="/static/js/topology.js"></script>
<script>window.addEventListener("load", function () { initTopology(); });</script>
