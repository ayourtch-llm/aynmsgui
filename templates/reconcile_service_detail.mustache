<h1 class="list-page-heading">Service: {{service}}</h1>
<p>
  <a href="/reconcile/services">← All services</a>
</p>

<div class="reconcile-summary">
  <div><strong>Service file:</strong> <code>{{service_path}}</code></div>
  <div><strong>Total port assignments across fleet:</strong> {{total_port_count}}</div>
  <div><strong>Already clean (no prologue):</strong>
    {{null_port_count}} port(s) across {{null_device_count}} device(s)</div>
</div>

<details style="margin: 12px 0;">
  <summary>Current <code>port-config.txt</code></summary>
  <pre style="background:#fafafa; border:1px solid #e3e3e3; border-radius:3px; padding:6px 10px;">{{port_config_preview}}</pre>
</details>

{{^has_rows}}
<p style="color:#1b5e20; font-weight:600;">
  ✓ Nothing to fold for this service — every port using it already has <code>prologue: null</code>.
</p>
{{/has_rows}}

{{#has_rows}}
<h2>Fold candidates</h2>
<p style="color:#666; font-size:0.9em;">
  Each row below is a distinct prologue value currently attached to this service across the
  fleet. Click <em>Fold into service</em> to prepend the line to <code>{{service_path}}</code>
  and clear the prologue field on every matching port.
</p>
<table class="reconcile-table">
<thead>
<tr>
  <th>Prologue</th>
  <th>Ports</th>
  <th>Devices</th>
  <th>Sample devices</th>
  <th>Action</th>
</tr>
</thead>
<tbody>
{{#rows}}
<tr>
  <td><code>{{prologue_display}}</code></td>
  <td>{{port_count}}</td>
  <td>{{device_count}}</td>
  <td><code style="font-size:0.85em; color:#555;">{{devices_preview}}</code></td>
  <td>
    <form method="GET" action="/reconcile/services/{{service}}/fold-prologue" style="display:inline;">
      <input type="hidden" name="prologue" value="{{prologue}}">
      <button type="submit" title="Move this line into {{service}}/port-config.txt and clear the prologue field on all matching ports">Fold into service …</button>
    </form>
  </td>
</tr>
{{/rows}}
</tbody>
</table>
{{/has_rows}}
